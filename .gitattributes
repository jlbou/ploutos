# Normalizacion de finales de linea.
#
# POR QUE IMPORTA: el despliegue copia estos ficheros de Windows al VPS Linux.
# Un script de shell con finales CRLF falla en Linux con "bad interpreter:
# /usr/bin/env bash^M", un error que no dice nada del problema real.
# Lo mismo con las unidades de systemd.

* text=auto

# Estos SIEMPRE con LF, se editen desde donde se editen.
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.conf      text eol=lf
*.sql       text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
.env.example text eol=lf

# Binarios: que git no los toque.
*.db        binary
*.gz        binary
*.png       binary
# Librerias de terceros: tal cual se bajaron (su huella se comprueba en los tests).
ui/vendor/*.js -text
