[Unit]
# Copia diaria de la base de datos (PRD seccion 11).
Description=Ploutos - copia de seguridad de la base de datos
After=ploutos-ingest.service

[Service]
Type=oneshot
User=ploutos
Group=ploutos
ExecStart=/usr/local/bin/ploutos-backup
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/backups/ploutos
SyslogIdentifier=ploutos-backup
