[Unit]
# El panel (fase 5): SOLO en la IP de Tailscale de esta maquina (el propietario, 25/09). Si Tailscale no esta,
# no arranca (scripts/run_panel.py). Solo LEE las bases (mode=ro); no manda nada a ningun sitio.
Description=Ploutos - panel (solo por Tailscale)
After=network-online.target tailscaled.service
Wants=network-online.target tailscaled.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=ploutos
Group=ploutos
WorkingDirectory=/opt/ploutos
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ploutos/.venv/bin/python /opt/ploutos/scripts/run_panel.py
# Si Tailscale aun no tiene IP al arrancar la maquina, reintenta.
Restart=always
RestartSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Las bases se abren en solo lectura, pero SQLite en WAL necesita tocar el -shm.
ReadWritePaths=/opt/ploutos/var
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=200M

[Install]
WantedBy=multi-user.target
