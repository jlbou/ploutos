# Ploutos — plantilla de secretos. Copiar a .env y rellenar.
# .env NUNCA se sube a git. Permisos 600 en el VPS.
# Las fases 1-3 NO necesitan ninguno de estos valores: funcionan con datos publicos.

# --- OKX (a partir de la fase 4; en fase 4 son las del entorno DEMO) ---
# Permisos: lectura + trading. NUNCA retirada. IP whitelist del VPS.
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSWORD=
OKX_DEMO=true

# --- Claude (a partir de la fase 3) ---
# Generado con `claude setup-token`. Valido 1 anyo.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Telegram (a partir de la fase 5) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Vigilante externo, Healthchecks.io (desde la fase 3) ---
# Una URL por comprobacion (https://hc-ping.com/...). Secretas: nunca por el chat.
HEALTHCHECK_INGESTA=
HEALTHCHECK_PAPEL=
HEALTHCHECK_PAPEL_IA=
HEALTHCHECK_COPIA=
# El servicio de noticias (ploutos-news): una quinta comprobacion, cuando se despliegue.
HEALTHCHECK_NOTICIAS=
# El servicio de comandos de Telegram (ploutos-telegram): una sexta comprobacion, cuando se despliegue.
HEALTHCHECK_TELEGRAM=
# El ejecutor del demo (ploutos-exec, fase 4): la octava comprobacion. Late solo si OKX contesta y no esta degradado.
HEALTHCHECK_EJECUTOR=
# Los medios en sombra (ploutos-medios, 07/10): la novena. Late si la mitad de los RSS o mas se leyeron bien.
HEALTHCHECK_MEDIOS=
# SOLO en el .env del PORTATIL: la copia diaria al portatil (deploy/daily-backup.ps1, desde el 01/10/2026).
# Septima comprobacion; avisa si pasan dos dias sin una copia buena (portatil apagado o tarea muerta).
HEALTHCHECK_COPIA_PORTATIL=
